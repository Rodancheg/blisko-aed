{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blisko-aed:registry-feature:1.0.0",
  "title": "Blisko AED — wspólna struktura danych",
  "type": "object",
  "required": [
    "type",
    "id",
    "schema_version",
    "geometry",
    "properties",
    "provenance",
    "verification"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "geometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "required": [
        "defibrillator_id",
        "location_object_name",
        "device_operational_status"
      ],
      "properties": {
        "defibrillator_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Wymagane. Trwały identyfikator AED, unikalny w obrębie źródła."
        },
        "location_object_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nazwa obiektu, w którym znajduje się AED."
        },
        "location_street": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ulica lokalizacji AED."
        },
        "location_building": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identyfikator tekstowy; zachowaj np. 25/27."
        },
        "location_postcode": {
          "type": [
            "string",
            "null"
          ],
          "description": "Kod jako tekst, np. 02-517."
        },
        "location_city": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nazwa miejscowości; nie zastępuje kodu TERC gminy."
        },
        "location_description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Wejście, piętro i dokładne położenie urządzenia."
        },
        "device_access_description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Oryginalny opis godzin; nie oznacza potwierdzonej dostępności teraz."
        },
        "device_availability": {
          "type": [
            "string",
            "null"
          ],
          "description": "Oryginalna wartość źródła. Tak/Nie nie określa sprawności urządzenia."
        },
        "device_public_access": {
          "type": [
            "string",
            "null"
          ],
          "description": "Publiczny/prywatny lub opis ograniczeń."
        },
        "device_location": {
          "type": [
            "string",
            "null"
          ],
          "description": "Wewnątrz / na zewnątrz i dodatkowy opis."
        },
        "device_manufacturer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Producent urządzenia."
        },
        "device_specifications": {
          "type": [
            "string",
            "null"
          ],
          "description": "Zachowaj wartość źródła bez nadawania jej niepotwierdzonego znaczenia."
        },
        "device_operational_status": {
          "enum": [
            "unknown",
            "operational",
            "out_of_service",
            "decommissioned"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_record_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_record_id": {
            "type": "string"
          },
          "source_updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "imported_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "last_verified_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Potwierdzenie weryfikacji AED. Zatwierdzenie publikacji przez administratora jest opisane oddzielnie w review."
    },
    "review": {
      "type": "object",
      "description": "Decyzja administratora o publikacji w aplikacji; nie potwierdza weryfikacji terenowej ani odpowiedzialności dostawcy.",
      "required": [
        "status",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "approved"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "method": {
          "const": "administrator_review"
        }
      }
    }
  },
  "additionalProperties": true
}
